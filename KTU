#include <stdio.h>

void sortDescending(int arr[], int n) {
    int i, j, temp;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (arr[j] < arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

int main() {
    int n, k, i;
    int points[100];
    int max_points = 0;
    int count;

    printf("Enter the total number of events (n): ");
    scanf("%d", &n);

    printf("Enter the maximum events allowed to participate (k): ");
    scanf("%d", &k);

    printf("Enter the activity points for each event:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &points[i]);
    }

    sortDescending(points, n);

    count = (k < n) ? k : n;

    for (i = 0; i < count; i++) {
        if (points[i] > 0) {
            max_points += points[i];
        } else {
            break; 
        }
    }

    printf("\nMaximum activity points that can be earned: %d\n", max_points);

    return 0;
}
